# Copy to .env.local and fill in with your Supabase project's values
# (Project Settings -> API). Without these, the site falls back to the
# static content in src/content/*.ts and auth/dashboard/admin routes are
# unusable — fine for browsing the public pages, not for anything else.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Analytics 4 (optional) — leave blank to disable analytics entirely.
# Get this from GA4 Admin -> Data Streams -> your web stream.
VITE_GA_MEASUREMENT_ID=

# Google Search Console (optional) — HTML tag verification method. Paste
# just the `content` value from the meta tag Search Console gives you.
VITE_GOOGLE_SITE_VERIFICATION=
