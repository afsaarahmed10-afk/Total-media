# Copy to .env.local and fill in with your Supabase project's values
# (Project Settings -> API). Without these, the site falls back to the
# static content in src/content/*.ts and auth/dashboard/admin routes are
# unusable — fine for browsing the public pages, not for anything else.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
